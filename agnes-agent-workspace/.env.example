# Model Provider: mock | agnes | openai | deepseek | zenmux | custom
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://apihub.agnes-ai.com/v1
MODEL_NAME=agnes-2.0-flash
MODEL_API_KEY=your_api_key_here
MODEL_TEMPERATURE=0.2

# Per-provider API keys used by model catalog presets.
# Never commit real keys.
# AGNES_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ZENMUX_API_KEY=

# Web search provider.
# Recommended for China: Bocha https://open.bochaai.com
WEB_SEARCH_PROVIDER=auto
# BOCHA_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# JINA_API_KEY=

# One-click local site builder.
SITE_LAUNCH_ENABLED=true
SITE_DEV_PORT=5180
SITES_OUTPUT_DIR=

# Server.
PORT=3001
NODE_ENV=development

# Storage: local JSON by default; use PostgreSQL for cloud persistence.
STORAGE_DRIVER=json
STORAGE_PATH=./storage
DATABASE_URL=

# PostgreSQL example:
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/agnes

# Redis checkpoint for cloud resume (optional).
# REDIS_URL=redis://127.0.0.1:6379
